<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppHotel.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="AppHotel"
    BackgroundColor="#F5F1E9">

    <Grid RowDefinitions="*,Auto">

        <!-- TELA PRINCIPAL -->
        <ContentView x:Name="HomeView" Grid.Row="0">
            <ScrollView>
                <VerticalStackLayout Spacing="20" Padding="20">

                    <!-- CABEÇALHO -->
                    <Border BackgroundColor="#183D35"
                            Padding="23"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">

                            <Label Text="APPHOTEL"
                                   FontSize="14"
                                   CharacterSpacing="4"
                                   FontAttributes="Bold"
                                   TextColor="#D6B98C"/>

                            <Label Text="Sua próxima estadia começa aqui."
                                   FontSize="29"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF"
                                   LineBreakMode="WordWrap"/>

                            <Label Text="CONFORTO • EXPERIÊNCIA • HOSPITALIDADE"
                                   FontSize="10"
                                   CharacterSpacing="1.5"
                                   TextColor="#D8E2D8"/>

                            <BoxView HeightRequest="2"
                                     WidthRequest="55"
                                     HorizontalOptions="Start"
                                     Color="#C98262"/>

                        </VerticalStackLayout>
                    </Border>

                    <!-- FORMULÁRIO -->
                    <VerticalStackLayout Spacing="5">

                        <Label Text="RESERVAS"
                               FontSize="11"
                               CharacterSpacing="3"
                               FontAttributes="Bold"
                               TextColor="#B47757"/>

                        <Label Text="Planeje sua hospedagem"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#183D35"/>

                        <Label Text="Preencha os dados para registrar uma nova reserva."
                               FontSize="13"
                               TextColor="#77766D"/>

                    </VerticalStackLayout>

                    <Border BackgroundColor="#FFFFFF"
                            Padding="18"
                            Stroke="#E6DED1"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="13">

                            <Label Text="DADOS DO HÓSPEDE"
                                   FontSize="11"
                                   CharacterSpacing="2"
                                   FontAttributes="Bold"
                                   TextColor="#183D35"/>

                            <Label Text="Nome completo"
                                   FontSize="12"
                                   TextColor="#77766D"/>

                            <Entry x:Name="NameEntry"
                                   Placeholder="Digite o nome do hóspede"
                                   BackgroundColor="#F5F1E9"
                                   TextColor="#183D35"
                                   PlaceholderColor="#99958B"/>

                            <BoxView HeightRequest="1"
                                     Color="#EAE3D8"/>

                            <Label Text="ACOMODAÇÃO"
                                   FontSize="11"
                                   CharacterSpacing="2"
                                   FontAttributes="Bold"
                                   TextColor="#183D35"/>

                            <Picker x:Name="RoomPicker"
                                    Title="Escolha sua acomodação"
                                    BackgroundColor="#F5F1E9"
                                    TextColor="#183D35">
                                <Picker.Items>
                                    <x:String>Quarto Standard</x:String>
                                    <x:String>Quarto Luxo</x:String>
                                    <x:String>Suíte</x:String>
                                    <x:String>Suíte Master</x:String>
                                </Picker.Items>
                            </Picker>

                            <BoxView HeightRequest="1"
                                     Color="#EAE3D8"/>

                            <Label Text="PERÍODO DA HOSPEDAGEM"
                                   FontSize="11"
                                   CharacterSpacing="2"
                                   FontAttributes="Bold"
                                   TextColor="#183D35"/>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">

                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="5">
                                    <Label Text="Check-in"
                                           FontSize="12"
                                           TextColor="#77766D"/>

                                    <DatePicker x:Name="CheckInPicker"
                                                BackgroundColor="#F5F1E9"
                                                TextColor="#183D35"
                                                FontSize="12"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="5">
                                    <Label Text="Check-out"
                                           FontSize="12"
                                           TextColor="#77766D"/>

                                    <DatePicker x:Name="CheckOutPicker"
                                                BackgroundColor="#F5F1E9"
                                                TextColor="#183D35"
                                                FontSize="12"/>
                                </VerticalStackLayout>

                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="#EAE3D8"/>

                            <Label Text="QUANTIDADE DE HÓSPEDES"
                                   FontSize="11"
                                   CharacterSpacing="2"
                                   FontAttributes="Bold"
                                   TextColor="#183D35"/>

                            <HorizontalStackLayout Spacing="15"
                                                   VerticalOptions="Center">

                                <Stepper x:Name="GuestsStepper"
                                         Minimum="1"
                                         Maximum="6"
                                         Value="2"
                                         ValueChanged="OnGuestsChanged"
                                         BackgroundColor="#F5F1E9"/>

                                <Label x:Name="GuestsLabel"
                                       Text="2 hóspedes"
                                       FontSize="14"
                                       TextColor="#183D35"
                                       VerticalOptions="Center"/>

                            </HorizontalStackLayout>

                            <Button Text="CONFIRMAR RESERVA"
                                    BackgroundColor="#183D35"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    CharacterSpacing="1"
                                    CornerRadius="10"
                                    HeightRequest="52"
                                    Clicked="OnReservarClicked"/>

                        </VerticalStackLayout>
                    </Border>

                    <!-- LISTA DE RESERVAS -->
                    <VerticalStackLayout Spacing="5">

                        <Label Text="SUA HOSPEDAGEM"
                               FontSize="11"
                               CharacterSpacing="3"
                               FontAttributes="Bold"
                               TextColor="#B47757"/>

                        <Label Text="Reservas cadastradas"
                               FontSize="23"
                               FontAttributes="Bold"
                               TextColor="#183D35"/>

                    </VerticalStackLayout>

                    <CollectionView x:Name="BookingList"
                                    HeightRequest="230">

                        <CollectionView.EmptyView>
                            <Border BackgroundColor="#EAE5DB"
                                    Padding="20"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14"/>
                                </Border.StrokeShape>

                                <Label Text="Suas reservas aparecerão aqui."
                                       TextColor="#77766D"
                                       HorizontalTextAlignment="Center"/>
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White"
                                        Padding="15"
                                        Margin="0,5"
                                        Stroke="#E6DED1"
                                        StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="6">

                                        <Label Text="{Binding Nome}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#183D35"/>

                                        <Label Text="{Binding Quarto}"
                                               FontSize="13"
                                               TextColor="#B47757"/>

                                        <Label Text="{Binding Periodo}"
                                               FontSize="12"
                                               TextColor="#77766D"/>

                                        <Label Text="{Binding Hospedes, StringFormat='Hóspedes: {0}'}"
                                               FontSize="12"
                                               TextColor="#77766D"/>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                    <Label Text="APPHOTEL • HOSPITALIDADE EM CADA DETALHE"
                           FontSize="9"
                           CharacterSpacing="1"
                           TextColor="#99958B"
                           HorizontalTextAlignment="Center"
                           Margin="0,10,0,15"/>

                </VerticalStackLayout>
            </ScrollView>
        </ContentView>

        <!-- TELA SOBRE -->
        <ContentView x:Name="AboutView"
                     Grid.Row="0"
                     IsVisible="False">

            <ScrollView>
                <VerticalStackLayout Padding="22"
                                     Spacing="20">

                    <Border BackgroundColor="#183D35"
                            Padding="25"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">

                            <Label Text="APPHOTEL"
                                   FontSize="13"
                                   CharacterSpacing="4"
                                   FontAttributes="Bold"
                                   TextColor="#D6B98C"/>

                            <Label Text="Mais que uma hospedagem. Uma experiência."
                                   FontSize="27"
                                   FontAttributes="Bold"
                                   TextColor="White"/>

                            <Label Text="Hospitalidade pensada para cada detalhe."
                                   FontSize="13"
                                   TextColor="#D8E2D8"/>

                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="10">

                        <Label Text="NOSSA PROPOSTA"
                               FontSize="11"
                               CharacterSpacing="3"
                               FontAttributes="Bold"
                               TextColor="#B47757"/>

                        <Label Text="Sobre o projeto"
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="#183D35"/>

                        <Label Text="O AppHotel é um aplicativo desenvolvido para facilitar o cadastro e a organização de reservas de hospedagem. A plataforma permite registrar hóspedes, selecionar acomodações, definir períodos de estadia e consultar as reservas cadastradas."
                               FontSize="15"
                               LineHeight="1.3"
                               TextColor="#62645D"/>

                    </VerticalStackLayout>

                    <Border BackgroundColor="#FFFFFF"
                            Padding="20"
                            Stroke="#E6DED1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">

                            <Label Text="DESENVOLVIMENTO"
                                   FontSize="11"
                                   CharacterSpacing="2"
                                   FontAttributes="Bold"
                                   TextColor="#B47757"/>

                            <Label Text="Desenvolvedora"
                                   FontSize="13"
                                   TextColor="#77766D"/>

                            <Label Text="Letícia Marques da Cunha"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#183D35"/>

                            <BoxView HeightRequest="1"
                                     Color="#EAE3D8"/>

                            <Label Text="Ano de desenvolvimento"
                                   FontSize="13"
                                   TextColor="#77766D"/>

                            <Label Text="2026"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#183D35"/>

                        </VerticalStackLayout>
                    </Border>

                    <Label Text="APPHOTEL"
                           FontSize="12"
                           CharacterSpacing="4"
                           FontAttributes="Bold"
                           TextColor="#183D35"
                           HorizontalOptions="Center"/>

                </VerticalStackLayout>
            </ScrollView>
        </ContentView>

        <!-- MENU INFERIOR -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              BackgroundColor="#183D35"
              Padding="10,8">

            <Button Grid.Column="0"
                    Text="⌂  INÍCIO"
                    FontSize="12"
                    CharacterSpacing="1"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    Clicked="OnHomeClicked"/>

            <Button Grid.Column="1"
                    Text="ⓘ  SOBRE"
                    FontSize="12"
                    CharacterSpacing="1"
                    BackgroundColor="Transparent"
                    TextColor="#D6B98C"
                    Clicked="OnAboutClicked"/>

        </Grid>

    </Grid>
</ContentPage>
